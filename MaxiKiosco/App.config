<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Emisor (kiosco): valores posibles = RI | Monotributo | Exento -->
		<add key="EmisorCondIva" value="RI" />
	</appSettings>
	<connectionStrings>
		<add name="cadena_conexion"
			 connectionString="server=localhost;user=root;password=root;database=maxikiosco;"
			 providerName="MySql.Data.MySqlClient" />
	</connectionStrings>
</configuration>